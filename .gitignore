# =====================================================================
# Allowlist: publish ONLY the Quartz site + the wiki notes it renders.
# Everything else (personal course files, pipeline tooling) stays local.
# =====================================================================

# 1) Ignore everything at the top level by default
/*

# 2) Allow the Quartz site folder.
#    (grace-study-hub/.gitignore still drops node_modules/, public/, etc.)
!/grace-study-hub

# 3) Inside llm-wiki, allow ONLY the wiki notes — not graph/raw/scripts/.obsidian
!/llm-wiki
/llm-wiki/*
!/llm-wiki/wiki

# 4) Keep this allowlist + the Vercel build config tracked
!/.gitignore
!/vercel.json

# 4a) Root package.json/lock: dependencies for the /api serverless functions
#     (e.g. @vercel/blob). node_modules stays ignored by the /* rule above.
!/package.json
!/package-lock.json

# 4b) Allow the serverless function that adds notes/files from the site
!/api

# 4c) Allow the /docs folder — GitHub Pages serves it as a redirect to Vercel
!/docs

# 4d) Allow /scripts. These are local CLIs, not published by Quartz (it only
#     renders grace-study-hub/content), but they must be in the repo: the site's
#     add-content modal tells you to run scripts/yt-note.mjs when YouTube
#     bot-gates the serverless caption fetch, so the script has to ship with it.
!/scripts

# 5) Never commit OS cruft anywhere in the tree
.DS_Store
.vercel
.env*
